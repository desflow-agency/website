generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String     @id @default(cuid())
  title       String
  description String
  price       Int
  position    Int        @default(0)
  icon        String     @default("Sparkles")
  promotion   Promotion?
  createdAt   DateTime   @default(now())
}

model Promotion {
  id        String   @id @default(cuid())
  serviceId String   @unique
  percent   Int
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  client      String
  category    String
  image       String
  description String
  date        DateTime @default(now())
}

model Testimonial {
  id     String @id @default(cuid())
  name   String
  role   String
  avatar String
  rating Int
  text   String
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  body      String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String @id @default("default")
  name         String @default("desflow")
  email        String @default("hello@desflow.pl")
  phone        String @default("+48 123 456 789")
  address      String @default("Warszawa, Polska")
  primaryColor String @default("#5B5CF0")
  heroTitle    String @default("Budujemy marki, ktore zostaja w pamieci.")
  ctaTitle     String @default("Gotowi rozwinac Twoja marke?")
}
